# Cấu hình môi trường Backend

# MongoDB URI - Chọn 1 trong 2 cách:

# CÁCH 1: MongoDB Local (cần cài MongoDB trên máy)
MONGO_URI=mongodb://127.0.0.1:27017/note_app

# CÁCH 2: MongoDB Atlas (Cloud - miễn phí, KHÔNG cần cài MongoDB)
# 1. Truy cập https://cloud.mongodb.com và đăng ký tài khoản miễn phí
# 2. Tạo một cluster M0 (Free)
# 3. Vào Database Access → Tạo user và mật khẩu
# 4. Vào Network Access → Add IP Address → Allow Access from Anywhere (0.0.0.0/0)
# 5. Vào Clusters → Connect → Drivers → Copy connection string
# 6. Dán vào đây (thay <password> bằng mật khẩu thực):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/note_app?retryWrites=true&w=majority

PORT=5000

